{
  "name": "easyclub",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.20.0",
  "scripts": {
    "dev": "pnpm -C apps/web dev",
    "build": "pnpm -C apps/web build",
    "build:pages": "cd apps/web && pnpm dlx @cloudflare/next-on-pages@1",
    "start": "pnpm -C apps/web start",
    "lint": "pnpm -C apps/web exec eslint . --max-warnings=0",
    "typecheck": "pnpm -C apps/web tsc --noEmit",
    "test": "pnpm -C apps/web vitest run",
    "test:e2e": "pnpm -C apps/web playwright test --project=chromium",
    "format": "prettier --write .",
    "prepare": "husky",
    "ci:md-guard": "node ./scripts/check-no-md.cjs"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "sharp",
      "workerd"
    ]
  },
  "lint-staged": {
    "apps/web/**/*.{ts,tsx,js}": [
      "pnpm -C apps/web exec eslint --no-warn-ignored --fix --max-warnings=0",
      "prettier --write"
    ],
    "apps/web/**/*.{css,json}": [
      "prettier --write"
    ],
    "*.{js,cjs,mjs,json,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "eslint": "^9.39.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.6.2"
  }
}
